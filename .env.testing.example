APP_NAME=Atom
APP_ENV=testing
APP_KEY=base64:dGVzdGluZy10ZXN0aW5nLXRlc3RpbmctdGVzdGluZy0=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
# phpunit.xml defaults for DB_DATABASE, DB_ADA_DATABASE and DB_PLUS_DATABASE
# override this file. Use those names or export different names in the shell.
DB_DATABASE=testing
# Ada owns table names Arcturus also uses, so its suite runs against its own
# database. Create it once: CREATE DATABASE testing_ada;
DB_ADA_DATABASE=testing_ada
# PlusEMU also needs its own database. Create it once: CREATE DATABASE testing_plus;
DB_PLUS_DATABASE=testing_plus
DB_USERNAME=root
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

MAIL_MAILER=array

# Testing specific settings
BCRYPT_ROUNDS=4
TELESCOPE_ENABLED=false

# Disable CAPTCHA for testing
GOOGLE_RECAPTCHA_ENABLED=0
CLOUDFLARE_TURNSTILE_ENABLED=0

# Cloudflare Turnstile (test keys)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google reCAPTCHA (dummy values for testing)
GOOGLE_RECAPTCHA_SITE_KEY=dummy_site_key
GOOGLE_RECAPTCHA_SECRET_KEY=dummy_secret_key
